---
---
<section
  id="about"
  aria-labelledby="about-heading"
  class="scroll-mt-8 py-24 md:py-28 px-6 sm:px-8 lg:px-24 bg-[#E0E4DE] relative z-10 reveal-section opacity-0 translate-y-12 transition-all duration-[800ms] ease-out"
>
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    
    {/* Left Column: Story & Engineering Approach */}
    <div class="lg:col-span-7 flex flex-col items-start">
      <span
        data-i18n="aboutTag"
        class="font-mono text-xs font-bold tracking-[0.22em] text-[#8B2C3E] bg-[#8B2C3E]/10 border border-[#8B2C3E]/25 px-4 py-1.5 rounded-full mb-6"
      >
        01 // ABOUT
      </span>

      <h2
        id="about-heading"
        data-i18n="aboutHeading"
        class="text-3xl sm:text-4xl lg:text-5xl font-black text-[#181F30] tracking-tight leading-[1.12] mb-6"
      >
        Engineering software that actually solves business problems.
      </h2>

      <p
        data-i18n="aboutP1"
        class="text-[#263244] text-base sm:text-lg leading-relaxed mb-5 font-normal"
      >
        I’m Imane Himmich, a Computer Engineer and Full-Stack Developer behind IH SOFTDEV. I don’t just write code to make things look pretty—I build web platforms, mobile apps, and automated systems designed to handle real users, real data, and real commercial growth.
      </p>

      <p
        data-i18n="aboutP2"
        class="text-[#374559] text-base sm:text-lg leading-relaxed mb-8 font-normal"
      >
        From custom B2B SaaS platforms and e-commerce ecosystems to cross-platform mobile apps and Google Ads acquisition, I handle the entire technical lifecycle. You get clean architecture, fast delivery, and direct communication with the engineer building your product.
      </p>

      {/* Quick Stats / Architectural Pills */}
      <div class="flex flex-wrap gap-2.5">
        <span
          data-i18n="aboutPill1"
          class="px-4 py-2 rounded-full bg-white/70 backdrop-blur-xs border border-[#634D75]/25 text-[#634D75] text-xs sm:text-sm font-bold shadow-2xs"
        >
          Computer Engineering Background
        </span>
        <span
          data-i18n="aboutPill2"
          class="px-4 py-2 rounded-full bg-white/70 backdrop-blur-xs border border-[#634D75]/25 text-[#634D75] text-xs sm:text-sm font-bold shadow-2xs"
        >
          Web &amp; Mobile Architecture
        </span>
        <span
          data-i18n="aboutPill3"
          class="px-4 py-2 rounded-full bg-white/70 backdrop-blur-xs border border-[#634D75]/25 text-[#634D75] text-xs sm:text-sm font-bold shadow-2xs"
        >
          Multilingual (FR / EN / TR / AR)
        </span>
      </div>
    </div>

    {/* Right Column: Tech-Stack & Quick-Facts Terminal Card */}
    <div class="lg:col-span-5 w-full">
      <div class="rounded-2xl border-2 border-[#634D75]/30 bg-[#151B2B] shadow-[0_24px_60px_rgba(19,24,38,0.22)] overflow-hidden">
        {/* Terminal Header */}
        <div class="bg-[#222B40] border-b border-[#E3D0C3]/20 px-5 py-3.5 flex items-center justify-between font-mono text-xs">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-xs bg-[#D46A6A]" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-xs bg-[#E5C07B]" aria-hidden="true"></span>
            <span class="w-2.5 h-2.5 rounded-xs bg-[#8AB88A]" aria-hidden="true"></span>
            <span data-i18n="aboutCardTitle" class="ml-2 text-[#E3D0C3] font-bold tracking-wider text-[11px]">
              CORE STACK &amp; QUICK FACTS
            </span>
          </div>
          <span class="text-[#8CE99A] font-semibold text-[11px] flex items-center gap-1.5 shrink-0">
            <span class="w-2 h-2 rounded-full bg-[#8CE99A] animate-pulse" aria-hidden="true"></span>
            IH SOFTDEV
          </span>
        </div>

        {/* Stack Capabilities List */}
        <ul class="divide-y divide-[#E3D0C3]/10 p-2 sm:p-3 font-mono text-xs sm:text-[13px]">
          <li class="px-3.5 py-3.5 flex items-center justify-between gap-4 rounded-lg hover:bg-white/[0.03] transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#61AFEF] shrink-0" aria-hidden="true"></span>
              <span class="text-white font-bold">React / Next.js</span>
            </div>
            <span data-i18n="aboutStack1Role" class="text-[#E3D0C3]/70 text-[11px] text-right">
              Web &amp; SaaS Platforms
            </span>
          </li>

          <li class="px-3.5 py-3.5 flex items-center justify-between gap-4 rounded-lg hover:bg-white/[0.03] transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#7FB4CA] shrink-0" aria-hidden="true"></span>
              <span class="text-white font-bold">Flutter (iOS &amp; Android)</span>
            </div>
            <span data-i18n="aboutStack2Role" class="text-[#E3D0C3]/70 text-[11px] text-right">
              Cross-Platform Mobile
            </span>
          </li>

          <li class="px-3.5 py-3.5 flex items-center justify-between gap-4 rounded-lg hover:bg-white/[0.03] transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#98C379] shrink-0" aria-hidden="true"></span>
              <span class="text-white font-bold">Node.js &amp; Python</span>
            </div>
            <span data-i18n="aboutStack3Role" class="text-[#E3D0C3]/70 text-[11px] text-right">
              APIs &amp; Automation
            </span>
          </li>

          <li class="px-3.5 py-3.5 flex items-center justify-between gap-4 rounded-lg hover:bg-white/[0.03] transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#8CE99A] shrink-0" aria-hidden="true"></span>
              <span class="text-white font-bold">Supabase &amp; PostgreSQL</span>
            </div>
            <span data-i18n="aboutStack4Role" class="text-[#E3D0C3]/70 text-[11px] text-right">
              Cloud DB &amp; Realtime
            </span>
          </li>

          <li class="px-3.5 py-3.5 flex items-center justify-between gap-4 rounded-lg hover:bg-white/[0.03] transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-full bg-[#FBBC04] shrink-0" aria-hidden="true"></span>
              <span class="text-white font-bold">Google Ads &amp; GA4</span>
            </div>
            <span data-i18n="aboutStack5Role" class="text-[#E3D0C3]/70 text-[11px] text-right">
              Acquisition &amp; Analytics
            </span>
          </li>
        </ul>

        {/* Terminal Footer */}
        <div class="bg-[#0E131F] border-t border-[#E3D0C3]/15 px-5 py-3.5 font-mono text-[11px] sm:text-xs text-[#E3D0C3]/85 flex items-center gap-2">
          <span class="text-[#9B85AD] font-bold" aria-hidden="true">&gt;</span>
          <span data-i18n="aboutCardFooter">Direct engineer communication • End-to-end delivery</span>
        </div>
      </div>
    </div>

  </div>
</section>
