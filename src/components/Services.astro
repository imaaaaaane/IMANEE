---
---
<section
  id="services"
  aria-labelledby="services-heading"
  class="scroll-mt-8 py-24 md:py-28 px-6 sm:px-8 lg:px-24 bg-[#131826] text-white relative z-10 overflow-hidden reveal-section opacity-0 translate-y-12 transition-all duration-[800ms] ease-out"
>
  {/* Subtle Architectural Grid & Ambient Glow */}
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(155,133,173,0.14),transparent_45%),radial-gradient(circle_at_85%_80%,rgba(139,44,62,0.16),transparent_45%)]"></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background-image: linear-gradient(to right, #E3D0C3 1px, transparent 1px), linear-gradient(to bottom, #E3D0C3 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <div class="max-w-7xl mx-auto relative z-10">
    {/* Section Header */}
    <div class="max-w-3xl">
      <span
        data-i18n="servicesTag"
        class="font-mono text-xs font-bold tracking-[0.22em] text-[#E3D0C3] bg-[#634D75]/35 border border-[#E3D0C3]/30 px-4 py-1.5 rounded-full inline-block mb-6"
      >
        02 // SERVICES
      </span>

      <h2
        id="services-heading"
        data-i18n="servicesHeading"
        class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight"
      >
        What We Build &amp; Deliver
      </h2>

      <p
        data-i18n="servicesSubtitle"
        class="text-lg sm:text-xl text-[#E3D0C3]/80 mt-4 font-normal leading-relaxed"
      >
        End-to-end engineering and digital growth—under one roof.
      </p>
    </div>

    {/* 4-Card Architectural Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-14">
      
      {/* Card 1: Custom Web Applications & SaaS */}
      <article class="group rounded-2xl bg-[#1A2235]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-[#9B85AD]/75 hover:shadow-[0_0_38px_rgba(155,133,173,0.18)]">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#242E46] border border-[#E3D0C3]/20 flex items-center justify-center text-[#E3D0C3] group-hover:border-[#9B85AD] group-hover:text-white transition-colors">
              <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <rect x="3" y="4" width="18" height="16" rx="2.5"></rect>
                <path stroke-linecap="round" d="M3 9h18M8 14h3m-3 3h5"></path>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold tracking-widest text-[#9B85AD]/70">01</span>
          </div>

          <h3 data-i18n="srv1Title" class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-[#E3D0C3] transition-colors">
            Custom Web Applications &amp; SaaS
          </h3>

          <p data-i18n="srv1Desc" class="text-[#C5CAE9]/85 text-sm sm:text-base leading-relaxed mb-8">
            Fast, secure web platforms, admin dashboards, and booking or ordering portals built from scratch. Designed to handle complex workflows and scale smoothly.
          </p>
        </div>

        <div class="pt-5 border-t border-[#E3D0C3]/10 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">React</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Vite / Next.js</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Tailwind CSS</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Supabase</span>
        </div>
      </article>

      {/* Card 2: iOS & Android Mobile Apps */}
      <article class="group rounded-2xl bg-[#1A2235]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-[#9B85AD]/75 hover:shadow-[0_0_38px_rgba(155,133,173,0.18)]">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#242E46] border border-[#E3D0C3]/20 flex items-center justify-center text-[#E3D0C3] group-hover:border-[#9B85AD] group-hover:text-white transition-colors">
              <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect>
                <path stroke-linecap="round" d="M10 6h4M11 18.5h2"></path>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold tracking-widest text-[#9B85AD]/70">02</span>
          </div>

          <h3 data-i18n="srv2Title" class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-[#E3D0C3] transition-colors">
            iOS &amp; Android Mobile Apps
          </h3>

          <p data-i18n="srv2Desc" class="text-[#C5CAE9]/85 text-sm sm:text-base leading-relaxed mb-8">
            Cross-platform mobile applications with native performance, offline support, real-time notifications, and seamless API integrations.
          </p>
        </div>

        <div class="pt-5 border-t border-[#E3D0C3]/10 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Flutter</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">iOS &amp; Android</span>
          <span data-i18n="srv2Tag3" class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">REST APIs</span>
          <span data-i18n="srv2Tag4" class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Cloud Sync</span>
        </div>
      </article>

      {/* Card 3: Backend Systems & Workflow Automation */}
      <article class="group rounded-2xl bg-[#1A2235]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-[#9B85AD]/75 hover:shadow-[0_0_38px_rgba(155,133,173,0.18)]">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#242E46] border border-[#E3D0C3]/20 flex items-center justify-center text-[#E3D0C3] group-hover:border-[#9B85AD] group-hover:text-white transition-colors">
              <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <ellipse cx="12" cy="6" rx="7.5" ry="3"></ellipse>
                <path d="M4.5 6v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3V6"></path>
                <path d="M4.5 12v6c0 1.66 3.36 3 7.5 3s7.5-1.34 7.5-3v-6"></path>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold tracking-widest text-[#9B85AD]/70">03</span>
          </div>

          <h3 data-i18n="srv3Title" class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-[#E3D0C3] transition-colors">
            Backend Systems &amp; Workflow Automation
          </h3>

          <p data-i18n="srv3Desc" class="text-[#C5CAE9]/85 text-sm sm:text-base leading-relaxed mb-8">
            Database design, secure authentication, payment gateways, and custom automation scripts that eliminate repetitive manual work in your business.
          </p>
        </div>

        <div class="pt-5 border-t border-[#E3D0C3]/10 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Node.js</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Python</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">PostgreSQL</span>
          <span data-i18n="srv3Tag4" class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">API Integration</span>
        </div>
      </article>

      {/* Card 4: Google Ads & Technical SEO */}
      <article class="group rounded-2xl bg-[#1A2235]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 hover:border-[#FBBC04]/55 hover:shadow-[0_0_38px_rgba(251,188,4,0.14)]">
        <div>
          <div class="flex items-center justify-between mb-6">
            <div class="w-12 h-12 rounded-xl bg-[#242E46] border border-[#E3D0C3]/20 flex items-center justify-center group-hover:border-[#FBBC04]/60 transition-colors">
              {/* Official-colored Google Ads Geometric Icon */}
              <svg aria-hidden="true" class="w-6 h-6" viewBox="0 0 24 24" fill="none">
                <rect x="3.2" y="13.2" width="12.5" height="4.8" rx="2.4" transform="rotate(-60 3.2 13.2)" fill="#FBBC04"></rect>
                <rect x="13.4" y="3.6" width="12.5" height="4.8" rx="2.4" transform="rotate(60 13.4 3.6)" fill="#4285F4"></rect>
                <circle cx="6.2" cy="18.2" r="2.5" fill="#34A853"></circle>
              </svg>
            </div>
            <span class="font-mono text-xs font-bold tracking-widest text-[#9B85AD]/70">04</span>
          </div>

          <h3 data-i18n="srv4Title" class="text-xl sm:text-2xl font-bold text-white mb-3 group-hover:text-[#E3D0C3] transition-colors">
            Google Ads &amp; Technical SEO
          </h3>

          <p data-i18n="srv4Desc" class="text-[#C5CAE9]/85 text-sm sm:text-base leading-relaxed mb-8">
            A great product needs traffic. We set up conversion tracking (GA4/GTM), optimize search visibility, and run high-ROAS Google Ads &amp; Merchant Center campaigns.
          </p>
        </div>

        <div class="pt-5 border-t border-[#E3D0C3]/10 flex flex-wrap items-center gap-2 font-mono text-xs">
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Google Ads</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Merchant Center</span>
          <span class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">GA4 &amp; GTM</span>
          <span data-i18n="srv4Tag4" class="px-2.5 py-1 rounded-md bg-[#242E46] text-[#E3D0C3] border border-[#E3D0C3]/15">Technical SEO</span>
        </div>
      </article>

    </div>
  </div>
</section>
