              <div class="flex items-center gap-2.5 text-[#E3D0C3]">
                <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#8CE99A] opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#8CE99A]"></span>
                </span>
                <span class="font-bold tracking-wider">BATMAN, TR — IH SOFTDEV</span>
              </div>
              <a
                href={MAPS_DIRECTION_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="contactOpenMaps"
                class="px-3 py-1 rounded-full bg-[#242E46] border border-[#E3D0C3]/25 text-[#E3D0C3] text-[11px] font-bold hover:bg-[#634D75] hover:text-white transition-colors shrink-0"
              >
                Open in Google Maps ↗
