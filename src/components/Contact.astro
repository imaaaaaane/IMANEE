---
---
<section id="contact-form" aria-labelledby="contact-heading" class="scroll-mt-8 py-24 px-8 lg:px-24 bg-[#E0E4DE] text-[#634D75] relative z-10 reveal-section opacity-0 translate-y-12 transition-all duration-[800ms] ease-out">
  <span id="contact" class="absolute -top-4 left-0 pointer-events-none" aria-hidden="true"></span>
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
    
    {/* Left Column */}
    <div>
      <h2 id="contact-heading" data-i18n-html="contactHeadingHtml" class="text-5xl md:text-7xl font-black text-[#634D75] tracking-tighter leading-tight">
        Let's build something<br/>incredible.
      </h2>
      <p data-i18n="contactSubtitle" class="mt-6 text-lg text-[#634D75]/80 max-w-md font-normal leading-relaxed">
        Planning a custom web platform, mobile application, or Google Ads growth strategy? Reach out directly—no agency middlemen.
      </p>
    </div>

    {/* Right Column (Form) */}
    <div class="bg-white/55 backdrop-blur-xl border border-white/70 shadow-xl rounded-[2.5rem] p-8 md:p-10">
      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
        <input type="hidden" name="access_key" value="7db86680-44b7-459f-994c-db34f1511b27" />
        <input type="hidden" name="redirect" value="https://web3forms.com/success" />

        <div>
          <label for="contact-name" data-i18n="contactNamePlaceholder" class="sr-only">Your Name</label>
          <input
            id="contact-name"
            type="text"
            name="name"
            autocomplete="name"
            placeholder="Your Name"
            data-i18n-placeholder="contactNamePlaceholder"
            required
            class="w-full bg-transparent border-b border-[#634D75]/30 focus:border-[#634D75] text-[#634D75] placeholder-[#634D75]/60 py-3 outline-none transition-colors"
          />
        </div>

        <div>
          <label for="contact-email" data-i18n="contactEmailPlaceholder" class="sr-only">Your Email</label>
          <input
            id="contact-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Your Email"
            data-i18n-placeholder="contactEmailPlaceholder"
            required
            class="w-full bg-transparent border-b border-[#634D75]/30 focus:border-[#634D75] text-[#634D75] placeholder-[#634D75]/60 py-3 outline-none transition-colors"
          />
        </div>

        <div>
          <label for="contact-phone" data-i18n="contactPhonePlaceholder" class="sr-only">Your Phone Number</label>
          <input
            id="contact-phone"
            type="tel"
            name="phone"
            autocomplete="tel"
            placeholder="Your Phone Number"
            data-i18n-placeholder="contactPhonePlaceholder"
            class="w-full bg-transparent border-b border-[#634D75]/30 focus:border-[#634D75] text-[#634D75] placeholder-[#634D75]/60 py-3 outline-none transition-colors"
          />
        </div>

        <div>
          <label for="contact-message" data-i18n="contactMessagePlaceholder" class="sr-only">Tell me about your project...</label>
          <textarea
            id="contact-message"
            name="message"
            placeholder="Tell me about your project..."
            data-i18n-placeholder="contactMessagePlaceholder"
            required
            class="w-full bg-transparent border-b border-[#634D75]/30 focus:border-[#634D75] text-[#634D75] placeholder-[#634D75]/60 py-3 outline-none transition-colors h-32 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          data-i18n="contactSubmit"
          class="bg-[#9B85AD] hover:bg-[#634D75] text-white font-bold py-4 rounded-xl transition-colors w-full !mt-6 cursor-pointer"
        >
          Send Message
        </button>
      </form>
    </div>
    
  </div>
</section>
