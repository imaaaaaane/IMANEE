---
const MAPS_DIRECTION_URL =
  'https://www.google.com/maps/search/?api=1&query=T%C4%B0LMER%C3%87+MH.+%C4%B0BRAH%C4%B0M+HAKKI+CD.+TOK%C4%B0+KAZIM+KARABEK%C4%B0R+ORTAOKUL+KAR%C5%9EISI+BATMAN';
const MAPS_EMBED_URL =
  'https://maps.google.com/maps?q=T%C4%B0LMER%C3%87%20MH.%20%C4%B0BRAH%C4%B0M%20HAKKI%20CD.%20TOK%C4%B0%20KAZIM%20KARABEK%C4%B0R%20ORTAOKULU%20BATMAN&t=&z=16&ie=UTF8&iwloc=&output=embed';
const currentYear = new Date().getFullYear();
---

<div class="bg-[#0F1422] text-white relative z-10 overflow-hidden">
  {/* Subtle Architectural Ambient Glow & Grid */}
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,rgba(155,133,173,0.14),transparent_45%),radial-gradient(circle_at_85%_65%,rgba(139,44,62,0.16),transparent_45%)]"></div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.035]"
    style="background-image: linear-gradient(to right, #E3D0C3 1px, transparent 1px), linear-gradient(to bottom, #E3D0C3 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  {/* PART 1: Architectural Contact & Interactive Google Map Showcase */}
  <section
    id="contact"
    aria-labelledby="contact-heading"
    class="scroll-mt-8 pt-24 pb-20 px-6 sm:px-8 lg:px-24 relative z-10 reveal-section opacity-0 translate-y-12 transition-all duration-[800ms] ease-out"
  >
    <span id="contact-form" class="absolute -top-4 left-0 pointer-events-none" aria-hidden="true"></span>

    <div class="max-w-7xl mx-auto">
      {/* Header */}
      <div class="max-w-3xl">
        <span
          data-i18n="contactTag"
          class="font-mono text-xs font-bold tracking-[0.22em] text-[#E3D0C3] bg-[#634D75]/35 border border-[#E3D0C3]/30 px-4 py-1.5 rounded-full inline-block mb-6"
        >
          04 // CONTACT
        </span>

        <h2
          id="contact-heading"
          data-i18n-html="contactHeadingHtml"
          class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08]"
        >
          Let's build something<br/>incredible.
        </h2>

        <p
          data-i18n="contactSubtitle"
          class="mt-5 text-base sm:text-lg text-[#E3D0C3]/80 max-w-2xl leading-relaxed"
        >
          Planning a custom web platform, mobile application, or Google Ads growth strategy? Reach out directly via phone, WhatsApp, email, or visit our office.
        </p>
      </div>

      {/* Bento Grid: Direct Contact Cards (Left) + Large Interactive Google Map (Right) */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 mt-14 items-stretch">
        
        {/* Left Column: Direct Contact Cards */}
        <div class="lg:col-span-5 flex flex-col justify-between gap-4">
          
          {/* Phone & WhatsApp Row (2 Compact Cards on sm+, or stacked cleanly) */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
            {/* Card 1: Direct Phone */}
            <a
              href="tel:+905362100021"
              aria-label="Call +90 536 210 00 21"
              class="group rounded-2xl bg-[#182033]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-5 sm:p-6 flex items-start gap-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#9B85AD]/75 hover:shadow-[0_12px_32px_rgba(155,133,173,0.16)]"
            >
              <div class="w-12 h-12 rounded-xl bg-[#242E46] border border-[#E3D0C3]/20 flex items-center justify-center text-[#E3D0C3] shrink-0 group-hover:bg-[#634D75] group-hover:text-white transition-colors">
                <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <span data-i18n="contactPhoneLabel" class="block font-mono text-[11px] font-bold tracking-[0.18em] text-[#E3D0C3]/60 uppercase mb-1">
                  DIRECT PHONE
                </span>
                <span class="block text-base sm:text-lg font-bold text-white group-hover:text-[#E3D0C3] transition-colors">
                  +90 536 210 00 21
                </span>
              </div>
            </a>

            {/* Card 2: WhatsApp Direct */}
            <a
              href="https://wa.me/905362100021"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp +90 536 210 00 21"
              class="group rounded-2xl bg-[#182033]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-5 sm:p-6 flex items-start gap-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#25D366]/60 hover:shadow-[0_12px_32px_rgba(37,211,102,0.14)]"
