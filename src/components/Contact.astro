              </span>
              <p class="text-sm sm:text-[15px] font-semibold text-white/95 leading-relaxed">
                TİLMERÇ MH. İBRAHİM HAKKI CD. TOKİ KAZIM KARABEKİR ORTAOKUL KARŞISI / BATMAN
              </p>
              <a
                href={MAPS_DIRECTION_URL}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="contactDirectionsBtn"
                class="inline-flex items-center gap-1.5 mt-3 text-xs font-bold tracking-wider uppercase text-[#E3D0C3] hover:text-white underline underline-offset-4 decoration-[#9B85AD] transition-colors"
