                Get Directions →
              </a>
            </div>
          </div>

        </div>

        {/* Right Column: Large Interactive Google Map Showcase */}
        <div class="lg:col-span-7 flex flex-col">
          <div class="rounded-3xl border-2 border-[#E3D0C3]/20 bg-[#182033] p-2.5 sm:p-3.5 shadow-[0_24px_65px_rgba(0,0,0,0.55)] flex-1 flex flex-col min-h-[420px] lg:min-h-full overflow-hidden">
