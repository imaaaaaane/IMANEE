            </div>

            {/* Embedded Interactive Google Map */}
            <div class="relative flex-1 w-full rounded-2xl overflow-hidden border border-[#E3D0C3]/15 bg-[#121726] min-h-[360px]">
              <iframe
                src={MAPS_EMBED_URL}
                title="IH SOFTDEV Office Location — Tilmerç Mh. İbrahim Hakkı Cd. Batman"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
                class="w-full h-full min-h-[360px] lg:absolute lg:inset-0 border-0 contrast-[1.03]"
              ></iframe>
            </div>
          </div>
        </div>

      </div>
