              <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <span data-i18n="contactEmailLabel" class="block font-mono text-[11px] font-bold tracking-[0.18em] text-[#E3D0C3]/60 uppercase mb-1">
                EMAIL ADDRESS
              </span>
              <span class="block text-base sm:text-lg font-bold text-white break-all group-hover:text-[#E3D0C3] transition-colors">
                imanehimmich10@gmail.com
              </span>
            </div>
