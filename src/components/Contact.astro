            class="group rounded-2xl bg-[#182033]/90 backdrop-blur-xs border border-[#E3D0C3]/15 p-5 sm:p-6 flex items-start gap-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-[#9B85AD]/75 hover:shadow-[0_12px_32px_rgba(155,133,173,0.16)]"
