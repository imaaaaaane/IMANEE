---
import '../styles/global.css';
import { translations, type TranslationDictionary } from '../i18n/translations';

interface Props {
	title?: string;
	description?: string;
	canonicalPath?: string;
	pageKey?: keyof Pick<TranslationDictionary, 'pageTitleHome' | 'pageTitleImpa' | 'pageTitleAlbumevi'>;
	descKey?: keyof Pick<TranslationDictionary, 'pageDescHome' | 'pageDescImpa' | 'pageDescAlbumevi'>;
}

const {
	title = translations.en.pageTitleHome,
	description = translations.en.pageDescHome,
	canonicalPath = '/',
	pageKey = 'pageTitleHome',
	descKey = 'pageDescHome',
} = Astro.props;

const SITE_ORIGIN = 'https://ihsoftdev.com';
const normalizedPath = canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${SITE_ORIGIN}${normalizedPath}`;
const ogUrl = normalizedPath === '/' ? SITE_ORIGIN : canonicalUrl;
const ogImageUrl = `${SITE_ORIGIN}/og-preview.jpg`;

const jsonLdSchema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${SITE_ORIGIN}/#person`,
			name: 'Imane Himmich',
			alternateName: 'IH SOFTDEV',
			url: SITE_ORIGIN,
			image: ogImageUrl,
			email: 'imanehimmich10@gmail.com',
			telephone: '+905362100021',
			jobTitle: 'Full-Stack Software Developer',
			description: translations.en.pageDescHome,
			knowsLanguage: ['en', 'fr', 'tr', 'ar'],
			knowsAbout: [
				'React',
				'Flutter',
				'Node.js',
				'Python',
				'Supabase',
				'Tailwind CSS',
				'Full-Stack Development',
				'Mobile App Development',
				'Google Ads',
			],
			worksFor: {
				'@id': `${SITE_ORIGIN}/#organization`,
			},
		},
		{
			'@type': 'ProfessionalService',
			'@id': `${SITE_ORIGIN}/#organization`,
			name: 'IH SOFTDEV',
			alternateName: 'Imane Himmich',
			url: SITE_ORIGIN,
			image: ogImageUrl,
			logo: `${SITE_ORIGIN}/favicon.svg`,
			description: translations.en.pageDescHome,
			email: 'imanehimmich10@gmail.com',
			telephone: '+905362100021',
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'TİLMERÇ MH. İBRAHİM HAKKI CD. TOKİ KAZIM KARABEKİR ORTAOKUL KARŞISI',
				addressLocality: 'Batman',
				addressCountry: 'TR',
			},
			founder: {
				'@id': `${SITE_ORIGIN}/#person`,
			},
			availableLanguage: ['en', 'fr', 'tr', 'ar'],
			knowsAbout: [
				'React',
				'Flutter',
				'Node.js',
				'Python',
				'Supabase',
				'Tailwind CSS',
				'Full-Stack Development',
				'Mobile App Development',
				'Google Ads',
			],
		},
	],
};
---

<!doctype html>
<html lang="en" dir="ltr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Imane Himmich (IH SOFTDEV)" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

		<!-- Canonical & Multilingual hreflang Alternates -->
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={`${canonicalUrl}?lang=en`} />
		<link rel="alternate" hreflang="fr" href={`${canonicalUrl}?lang=fr`} />
		<link rel="alternate" hreflang="tr" href={`${canonicalUrl}?lang=tr`} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />

		<!-- Open Graph / WhatsApp / LinkedIn -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:site_name" content="Imane Himmich | IH SOFTDEV" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:locale:alternate" content="fr_FR" />
		<meta property="og:locale:alternate" content="tr_TR" />

		<!-- Twitter / X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={ogUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta name="twitter:image:alt" content={title} />

		<!-- Schema.org JSON-LD Structured Data (Person & ProfessionalService) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdSchema)} />

		<!-- Synchronous Early Language & LTR Setup -->
		<script is:inline>
			(function () {
				try {
					document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
					document.documentElement.dir = 'ltr';
					var valid = ['fr', 'en', 'tr'];
					var urlLang = new URLSearchParams(window.location.search).get('lang');
					var saved = localStorage.getItem('lang');
					var lang = valid.indexOf(urlLang) !== -1
						? urlLang
						: valid.indexOf(saved) !== -1
							? saved
							: 'en';
					localStorage.setItem('lang', lang);
					document.documentElement.lang = lang;
				} catch (e) {
					document.documentElement.lang = 'en';
					document.documentElement.dir = 'ltr';
				}
			})();
		</script>
	</head>
	<body class="overflow-x-hidden min-h-screen bg-[#E0E4DE]" dir="ltr">
		<slot />

		<!-- Floating WhatsApp Button -->
		<a
			href="https://wa.me/905362100021"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="Chat on WhatsApp with Imane Himmich (IH SOFTDEV)"
			data-i18n-aria="whatsappAria"
			class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white p-4 rounded-full shadow-[0_8px_24px_rgba(37,211,102,0.4)] hover:scale-110 hover:-translate-y-1 transition-all duration-300 flex items-center justify-center group"
		>
			<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
			</svg>
		</a>

		<!-- Synchronous Multilingual SEO & UI Controller -->
		<script is:inline define:vars={{ translations, pageKey, descKey }}>
			(function () {
				var VALID_LANGS = ['fr', 'en', 'tr'];

				function setMetaContent(selector, value) {
					if (!value) return;
					var el = document.querySelector(selector);
					if (el) {
						el.setAttribute('content', value);
					}
				}

				function getActiveLang() {
					try {
						var urlLang = new URLSearchParams(window.location.search).get('lang');
						if (urlLang && VALID_LANGS.indexOf(urlLang) !== -1) {
							return urlLang;
						}
						var saved = localStorage.getItem('lang');
						if (saved && VALID_LANGS.indexOf(saved) !== -1) {
							return saved;
						}
					} catch (e) {}
					return 'en';
				}

				function applyLanguage(lang) {
					var activeLang = VALID_LANGS.indexOf(lang) !== -1 ? lang : 'en';
					var dict = translations[activeLang] || translations.en;

					try {
						localStorage.setItem('lang', activeLang);
					} catch (e) {}

					document.documentElement.lang = activeLang;
					document.documentElement.dir = 'ltr';
					document.body.dir = 'ltr';

					var nextTitle = (pageKey && dict[pageKey]) || dict.pageTitleHome;
					var nextDesc = (descKey && dict[descKey]) || dict.pageDescHome;

					if (nextTitle) {
						document.title = nextTitle;
						setMetaContent('meta[property="og:title"]', nextTitle);
						setMetaContent('meta[property="og:image:alt"]', nextTitle);
						setMetaContent('meta[name="twitter:title"]', nextTitle);
						setMetaContent('meta[name="twitter:image:alt"]', nextTitle);
					}

					if (nextDesc) {
						setMetaContent('meta[name="description"]', nextDesc);
						setMetaContent('meta[property="og:description"]', nextDesc);
						setMetaContent('meta[name="twitter:description"]', nextDesc);
					}

					if (dict.ogLocale) {
						setMetaContent('meta[property="og:locale"]', dict.ogLocale);
					}

					document.querySelectorAll('[data-i18n]').forEach(function (el) {
						var key = el.getAttribute('data-i18n');
						if (key && dict[key] !== undefined) {
							el.textContent = dict[key];
						}
					});

					document.querySelectorAll('[data-i18n-html]').forEach(function (el) {
						var key = el.getAttribute('data-i18n-html');
						if (key && dict[key] !== undefined) {
							el.innerHTML = dict[key];
						}
					});

					document.querySelectorAll('[data-i18n-placeholder]').forEach(function (el) {
						var key = el.getAttribute('data-i18n-placeholder');
						if (key && dict[key] !== undefined) {
							el.setAttribute('placeholder', dict[key]);
						}
					});

					document.querySelectorAll('[data-i18n-aria]').forEach(function (el) {
						var key = el.getAttribute('data-i18n-aria');
						if (key && dict[key] !== undefined) {
							el.setAttribute('aria-label', dict[key]);
						}
					});

					var toggleBtn = document.getElementById('view-toggle');
					if (toggleBtn) {
						var mode = toggleBtn.getAttribute('data-view-mode') || 'cinematic';
						toggleBtn.textContent = mode === 'static' ? dict.viewStatic : dict.viewCinematic;
					}

					document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
						var btnLang = btn.getAttribute('data-lang-btn');
						var isActive = btnLang === activeLang;
						btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
						if (isActive) {
							btn.classList.add('border-current', 'opacity-100');
							btn.classList.remove('border-transparent', 'opacity-60');
						} else {
							btn.classList.remove('border-current', 'opacity-100');
							btn.classList.add('border-transparent', 'opacity-60');
						}
					});

					window.dispatchEvent(new CustomEvent('portfolio:langchange', { detail: { lang: activeLang } }));
				}

				window.__setPortfolioLang = applyLanguage;
				window.__refreshPortfolioI18n = function () {
					applyLanguage(getActiveLang());
				};

				applyLanguage(getActiveLang());

				document.querySelectorAll('[data-lang-btn]').forEach(function (btn) {
					btn.addEventListener('click', function (e) {
						e.preventDefault();
						var chosen = btn.getAttribute('data-lang-btn');
						if (chosen) {
							applyLanguage(chosen);
						}
					});
				});
			})();
		</script>
	</body>
</html>
