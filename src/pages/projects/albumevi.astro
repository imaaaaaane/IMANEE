---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/translations';
---

<Layout
  title={translations.en.pageTitleAlbumevi}
  description={translations.en.pageDescAlbumevi}
  canonicalPath="/projects/albumevi/"
  pageKey="pageTitleAlbumevi"
  descKey="pageDescAlbumevi"
>
  {/* Top Navigation & Language Switcher */}
  <header class="w-full bg-[#F5F2F7] px-6 sm:px-10 pt-6 flex items-center justify-between text-[#634D75]">
    <a href="/" data-i18n="backToHome" class="text-sm font-bold hover:text-[#9B85AD] transition-colors">
      ← Back to Portfolio
    </a>
    <div class="flex items-center gap-3 sm:gap-4 text-xs font-bold tracking-widest" role="group" aria-label="Language Switcher">
      <button type="button" data-lang-btn="fr" aria-label="Switch site language to French (FR)" data-i18n-aria="langSwitchFrAria" class="border-b-2 border-transparent opacity-60 pb-1 hover:opacity-100 transition-all cursor-pointer">FR</button>
      <button type="button" data-lang-btn="en" aria-label="Switch site language to English (EN)" data-i18n-aria="langSwitchEnAria" class="border-b-2 border-current opacity-100 pb-1 hover:opacity-100 transition-all cursor-pointer">EN</button>
      <button type="button" data-lang-btn="tr" aria-label="Switch site language to Turkish (TR)" data-i18n-aria="langSwitchTrAria" class="border-b-2 border-transparent opacity-60 pb-1 hover:opacity-100 transition-all cursor-pointer">TR</button>
    </div>
  </header>

  <main class="min-h-screen bg-gradient-to-b from-[#F5F2F7] via-[#EFEAF2] to-[#E3D0C3] pt-16 pb-16 px-6">
    <!-- Logo -->
    <img src="/albumevilogo.png" alt="Albümevi school photography brand logo" class="h-32 md:h-40 w-auto object-contain mx-auto mb-8 drop-shadow-sm" />
    
    <!-- Title & Date -->
    <h1 class="text-[#634D75] text-5xl md:text-6xl font-black text-center mb-3">ALBÜMEVİ</h1>
    <p data-i18n="projectDate" class="text-black font-bold text-xl text-center mb-10">Project Date: 2026</p>
    
    <!-- Description -->
    <p data-i18n="albumeviDesc" class="text-black text-lg md:text-xl leading-relaxed max-w-3xl mx-auto text-center font-medium mb-12">
      Comprehensive digital platform and web infrastructure for professional school photography. Featuring edge-deployed photo management, custom photobook templates, and secure delivery architectures tailored for seamless client experiences.
    </p>
    
    <!-- Tags & Button Container -->
    <div class="flex flex-col items-center gap-8 mt-2">
      <div class="max-w-4xl mx-auto bg-white/30 backdrop-blur-md rounded-[2.5rem] py-6 px-8 flex flex-wrap items-center justify-center gap-4 shadow-sm border border-white/50">
        <span class="px-6 py-3 rounded-full bg-[#634D75] text-white text-sm font-bold shadow-md hover:bg-[#523d61] transition-colors cursor-default">React</span>
        <span class="px-6 py-3 rounded-full bg-[#634D75] text-white text-sm font-bold shadow-md hover:bg-[#523d61] transition-colors cursor-default">Supabase</span>
        <span class="px-6 py-3 rounded-full bg-[#634D75] text-white text-sm font-bold shadow-md hover:bg-[#523d61] transition-colors cursor-default">Figma</span>
        <span class="px-6 py-3 rounded-full bg-[#634D75] text-white text-sm font-bold shadow-md hover:bg-[#523d61] transition-colors cursor-default">Cloudflare</span>
      </div>
      
      <a href="https://www.albumevi.com.tr" target="_blank" rel="noopener noreferrer" class="px-10 py-4 rounded-full bg-[#634D75] text-white text-lg font-black shadow-[0_8px_16px_rgba(99,77,117,0.25)] hover:bg-[#523d61] hover:scale-105 hover:shadow-[0_12px_24px_rgba(99,77,117,0.35)] transition-all duration-300 flex items-center gap-3">
        <span data-i18n="visitLiveSite">VISIT LIVE SITE →</span>
      </a>
    </div>

    <!-- Project Showcase Section -->
    <section class="w-full" aria-labelledby="albumevi-showcase-heading">
      <h2 id="albumevi-showcase-heading" data-i18n="projectShowcase" class="text-[#634D75] text-2xl md:text-3xl font-black text-center mt-24 mb-12 tracking-tight">Project Showcase.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-10 max-w-7xl mx-auto pb-32 px-6 items-start">
        <img
          src="/show1.png"
          alt="Albümevi school photography web platform landing page designed by Imane Himmich (IH SOFTDEV)"
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-[2rem] shadow-2xl border border-white/60 ring-1 ring-black/5 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(99,77,117,0.2)] transition-all duration-700 object-cover"
        />
        
        <img
          src="/show2.png"
          alt="Albümevi interactive photobook template selector built with React and Supabase"
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-[2rem] shadow-2xl border border-white/60 ring-1 ring-black/5 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(99,77,117,0.2)] transition-all duration-700 object-cover md:mt-16"
        />
        
        <img
          src="/show3.png"
          alt="Albümevi edge-deployed client gallery and order management interface"
          loading="lazy"
          decoding="async"
          class="w-full h-auto rounded-[2rem] shadow-2xl border border-white/60 ring-1 ring-black/5 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(99,77,117,0.2)] transition-all duration-700 object-cover"
        />
      </div>
    </section>
  </main>
</Layout>
