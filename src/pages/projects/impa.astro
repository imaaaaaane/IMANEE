---
import Layout from '../../layouts/Layout.astro';
import { translations } from '../../i18n/translations';
---

<Layout
  title={translations.en.pageTitleImpa}
  description={translations.en.pageDescImpa}
  canonicalPath="/projects/impa/"
  pageKey="pageTitleImpa"
  descKey="pageDescImpa"
>
  {/* Top Navigation & Language Switcher */}
  <header class="absolute top-0 left-0 w-full z-50 px-6 sm:px-10 py-6 flex items-center justify-between text-[#634D75]">
    <a href="/" data-i18n="backToHome" class="text-sm font-bold hover:text-[#9B85AD] transition-colors">
      ← Back to Portfolio
    </a>
    <div class="flex items-center gap-3 sm:gap-4 text-xs font-bold tracking-widest" role="group" aria-label="Language Switcher">
      <button type="button" data-lang-btn="fr" aria-label="Switch site language to French (FR)" data-i18n-aria="langSwitchFrAria" class="border-b-2 border-transparent opacity-60 pb-1 hover:opacity-100 transition-all cursor-pointer">FR</button>
      <button type="button" data-lang-btn="en" aria-label="Switch site language to English (EN)" data-i18n-aria="langSwitchEnAria" class="border-b-2 border-current opacity-100 pb-1 hover:opacity-100 transition-all cursor-pointer">EN</button>
      <button type="button" data-lang-btn="tr" aria-label="Switch site language to Turkish (TR)" data-i18n-aria="langSwitchTrAria" class="border-b-2 border-transparent opacity-60 pb-1 hover:opacity-100 transition-all cursor-pointer">TR</button>
    </div>
  </header>

  <main>
    {/* Hero Section */}
    <section class="relative w-full h-[70vh] flex items-center justify-center" style="background-image: url('/image.png'); background-size: cover; background-position: center;">
      <div class="absolute inset-0 bg-gradient-to-b from-[#634D75]/30 via-[#634D75]/10 to-[#E3D0C3] z-0"></div>
      <div class="relative z-10 bg-white/20 backdrop-blur-md p-8 rounded-3xl border border-white/40 shadow-2xl">
        <img src="/impa.png" alt="IMPA Mobilya brand logo" class="h-28 md:h-36 w-auto object-contain" />
      </div>
    </section>

    {/* Project Details Section */}
    <section class="w-full bg-[#E3D0C3]">
      <div class="relative z-20 max-w-5xl mx-auto px-6 pb-24 -mt-10 text-center md:text-left flex flex-col items-center md:items-start">
        
        <h1 class="text-[#634D75] text-5xl md:text-6xl font-black mb-3 drop-shadow-sm">IMPA Mobilya</h1>
        <p data-i18n="projectDate" class="text-[#9B85AD] font-bold text-xl mb-8">Project Date: 2026</p>
        
        <p data-i18n="impaDesc" class="text-[#634D75]/90 text-lg md:text-xl leading-relaxed max-w-3xl font-medium mb-10">
          A high-performance digital platform and mobile architecture for IMPA Mobilya. Architected a seamless user experience for premium furniture browsing, backed by a robust full-stack infrastructure for dynamic catalog management and secure data handling.
        </p>

        <div class="flex flex-col items-center md:items-start gap-8 mt-2 w-full">
          <div class="flex flex-wrap justify-center md:justify-start gap-3">
            <span class="px-5 py-2.5 rounded-full bg-white/50 backdrop-blur-sm text-[#634D75] text-sm font-bold border border-white/60 shadow-sm transition-colors hover:bg-white/70">Flutter</span>
            <span class="px-5 py-2.5 rounded-full bg-white/50 backdrop-blur-sm text-[#634D75] text-sm font-bold border border-white/60 shadow-sm transition-colors hover:bg-white/70">Dart</span>
            <span class="px-5 py-2.5 rounded-full bg-white/50 backdrop-blur-sm text-[#634D75] text-sm font-bold border border-white/60 shadow-sm transition-colors hover:bg-white/70">Supabase</span>
            <span class="px-5 py-2.5 rounded-full bg-white/50 backdrop-blur-sm text-[#634D75] text-sm font-bold border border-white/60 shadow-sm transition-colors hover:bg-white/70">Figma</span>
          </div>

          <a href="https://www.impamobilya.com/" target="_blank" rel="noopener noreferrer" class="px-10 py-4 rounded-full bg-[#634D75] text-white text-lg font-black shadow-[0_8px_16px_rgba(99,77,117,0.25)] hover:bg-[#523d61] hover:scale-105 hover:shadow-[0_12px_24px_rgba(99,77,117,0.35)] transition-all duration-300 flex items-center gap-3">
            <span data-i18n="visitLiveSite">VISIT LIVE SITE →</span>
          </a>
        </div>
      </div>

      {/* Project Showcase Section */}
      <section class="w-full" aria-labelledby="impa-showcase-heading">
        <h2 id="impa-showcase-heading" data-i18n="projectShowcase" class="text-[#634D75] text-2xl md:text-3xl font-black text-center mt-24 mb-12 tracking-tight">Project Showcase.</h2>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-10 max-w-7xl mx-auto pb-32 px-6 items-start">
          <img
            src="/impa-mockup-1.jpg"
            alt="IMPA Mobilya Flutter mobile application furniture catalog mockup by Imane Himmich (IH SOFTDEV)"
            loading="lazy"
            decoding="async"
            class="md:col-span-7 w-full h-auto rounded-[2rem] shadow-2xl border border-white/60 ring-1 ring-black/5 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(99,77,117,0.2)] transition-all duration-700 object-cover"
          />
          
          <img
            src="/impa-mockup-2.jpg"
            alt="IMPA Mobilya responsive full-stack web storefront interface by Imane Himmich (IH SOFTDEV)"
            loading="lazy"
            decoding="async"
            class="md:col-span-5 w-full h-auto rounded-[2rem] shadow-2xl border border-white/60 ring-1 ring-black/5 hover:-translate-y-3 hover:shadow-[0_20px_40px_rgba(99,77,117,0.2)] transition-all duration-700 object-cover md:mt-24"
          />
        </div>
      </section>
    </section>
  </main>
</Layout>
